# Copy to .env.local and fill in. Only VITE_ values reach the browser, so never
# put secrets here — the AI key and Paystack secret key live on the backend.

# Backend address. Leave empty to run the site in demo mode (no server).
VITE_API_URL=

# Paystack PUBLIC key (starts with pk_), used by the checkout popup.
VITE_PAYSTACK_PUBLIC_KEY=
